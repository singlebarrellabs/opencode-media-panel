{
  "name": "opencode-media-panel",
  "version": "0.1.0",
  "description": "OpenCode v2 TUI plugin: play GIFs and video inside a session panel.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "tui",
    "gif",
    "video",
    "animation",
    "ffmpeg",
    "terminal"
  ],
  "license": "MIT",
  "author": "Single Barrel Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singlebarrellabs/opencode-media-panel.git"
  },
  "bugs": {
    "url": "https://github.com/singlebarrellabs/opencode-media-panel/issues"
  },
  "homepage": "https://github.com/singlebarrellabs/opencode-media-panel#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.6.7",
    "@opencode/plugin": "^2.3.2",
    "@opentui/core": "^0.9.0",
    "@opentui/solid": "^0.9.0",
    "@types/node": "^26.6.6",
    "babel-preset-solid": "^1.9.19",
    "markdownlint-cli2": "^0.24.0",
    "solid-js": "^2.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  }
}
